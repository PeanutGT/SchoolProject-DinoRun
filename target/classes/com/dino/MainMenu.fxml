<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootBox" prefHeight="500.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dino.MainMenuController">
   <children>
      <Pane fx:id="backgroundPane" maxHeight="500.0" maxWidth="1000.0" prefHeight="500.0" prefWidth="1000.0" />
      <VBox fx:id="menuContent" alignment="CENTER" maxHeight="500.0" maxWidth="1000.0" prefHeight="500.0" prefWidth="1000.0" spacing="20.0">
         <children>
            <VBox fx:id="mainContent" alignment="CENTER" spacing="20.0">
               <children>
                  <Text text="Dino Run">
                     <font>
                        <Font size="40.0" />
                     </font>
                  </Text>
                  <Button mnemonicParsing="false" onAction="#startGame" prefWidth="200.0" text="單人遊戲" />
                  <Button mnemonicParsing="false" onAction="#startCoopGame" prefWidth="200.0" text="雙人合作" />
                  <Button mnemonicParsing="false" onAction="#startVersusGame" prefWidth="200.0" text="雙人對戰" />
                  <Button mnemonicParsing="false" onAction="#showLeaderboard" prefWidth="200.0" text="排行榜" />
                  <Button mnemonicParsing="false" onAction="#openShop" prefWidth="200.0" text="進化商店" />
                  <Button mnemonicParsing="false" onAction="#openSettings" prefWidth="200.0" text="遊戲設定" />
                  <Button mnemonicParsing="false" onAction="#exitGame" prefWidth="200.0" text="離開遊戲" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
